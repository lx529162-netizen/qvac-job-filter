# Copy to .env and fill in. Never commit .env.
TG_API_ID=123456
TG_API_HASH=your_api_hash
# A NEW session name, different from the cloud script's session file
TG_SESSION=qvac_session
# Channel for the QVAC run: @username for a public channel, or numeric id like -1001234567890 for a private one.
# The logged-in account must be an admin who can post there.
TARGET_CHANNEL=-1001234567890
CHANNELS_FILE=channels.txt
QVAC_MODEL=QWEN3_4B_INST_Q4_K_M
QVAC_CTX_SIZE=4096
