# Copy to .env and fill in. Never commit .env.
TG_API_ID=123456
TG_API_HASH=your_api_hash
# A NEW session name, different from the cloud script's session file
TG_SESSION=qvac_session
# Your private test channel for the QVAC run
TARGET_CHANNEL=your_qvac_channel
CHANNELS_FILE=channels.txt
QVAC_MODEL=QWEN3_4B_INST_Q4_K_M
QVAC_CTX_SIZE=4096
